{
  "version": 2,
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/frontend/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "frontend/**"
    }
  },
  "crons": [
    {
      "path": "/api/backup-diario",
      "schedule": "0 20 * * *"
    }
  ]
}

